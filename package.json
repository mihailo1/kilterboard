{
  "name": "kilterboard",
  "private": true,
  "version": "1.1.6",
  "scripts": {
    "predev": "node scripts/ensure-boardsesh-db.mjs",
    "dev": "next dev",
    "build": "node scripts/ensure-boardsesh-db.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "sync:climbs": "node scripts/sync-boardsesh.mjs",
    "sync:climbs:force": "node scripts/sync-boardsesh.mjs --force",
    "sync:climbs:check": "node scripts/sync-boardsesh.mjs --check-only",
    "ensure:climbs": "node scripts/ensure-boardsesh-db.mjs",
    "train:boulder-ai": "node scripts/train-boulder-ai.mjs",
    "eval:boulder-ai": "node scripts/eval-boulder-ai.mjs",
    "apply-feedback": "node scripts/apply-feedback.mjs",
    "ml:export-sequences": "node scripts/ml/export-climb-sequences.mjs",
    "ml:export-onnx": "cd ml/hold-ar && ./.venv/bin/python export_onnx.py --ckpt artifacts/hold-ar-v1.pt --out artifacts/hold-ar-v1.onnx --copy-public"
  },
  "dependencies": {
    "@hangtime/grip-connect": "^0.15.0",
    "@radix-ui/react-slider": "^1.4.7",
    "next": "^16.3.0",
    "onnxruntime-web": "^1.20.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-zoom-pan-pinch": "^4.0.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.10",
    "@types/node": "^22.15.30",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
